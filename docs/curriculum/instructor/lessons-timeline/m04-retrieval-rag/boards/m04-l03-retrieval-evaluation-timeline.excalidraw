    {
      "id": "e6_demo_card_text",
      "type": "text",
      "x": 113.440185546875,
      "y": 1110,
      "width": 613.11962890625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
