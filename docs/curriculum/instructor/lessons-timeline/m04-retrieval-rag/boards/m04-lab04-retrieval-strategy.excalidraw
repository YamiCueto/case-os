    {
      "id": "z6_demo_block_text",
      "type": "text",
      "x": 886,
      "y": 1105,
      "width": 608,
      "height": 170,
      "angle": 0,
      "strokeColor": "#dcfce7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
