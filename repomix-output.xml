  line-height: 1.6;
}

.hints-list li::before {
  content: "💡";
  position: absolute;
  left: 0;
  font-size: 1.125rem;
}

/* Time Estimate */
.time-estimate {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #f0fdf4;
  padding: 1rem 1.5rem;
  border-radius: 8px;
  margin-top: 2rem;
  color: #065f46;
  font-weight: 700;
  font-size: 1.05rem;
}

.time-estimate .material-icons {
  color: #10b981;
  font-size: 1.5rem;
}

/* Practices Grid */
.practices-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.practice-category {
  background: white;
  border: 2px solid #e5e7eb;
  border-radius: 12px;
  padding: 1.5rem;
}

.practice-category h3 {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1.125rem;
  font-weight: 700;
  color: #667eea;
  margin: 0 0 1rem 0;
  padding-bottom: 1rem;
  border-bottom: 2px solid #e5e7eb;
}

.practice-category h3 .material-icons {
  color: #f59e0b;
  font-size: 1.5rem;
}

.practices-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.practices-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.75rem 0;
  color: #374151;
  line-height: 1.6;
}

.practices-list li .material-icons {
  color: #667eea;
  font-size: 1.25rem;
  flex-shrink: 0;
  margin-top: 0.125rem;
}

/* Summary Grid */
.summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.summary-card {
  background: white;
  border: 2px solid #e5e7eb;
  border-radius: 12px;
  padding: 1.5rem;
}

.summary-card .material-icons {
  color: #667eea;
  font-size: 3rem;
  margin-bottom: 1rem;
}

.summary-card h3 {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1f2937;
  margin: 0 0 1rem 0;
}

.summary-card ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.summary-card li {
  padding: 0.5rem 0;
  padding-left: 1.5rem;
  position: relative;
  color: #4b5563;
  line-height: 1.6;
}

.summary-card li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #10b981;
  font-weight: 700;
}

/* Next Steps */
.next-steps {
  margin-top: 2rem;
}

.next-steps h3 {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 1.5rem;
}

.next-step-item {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
  background: white;
  border: 2px solid #e5e7eb;
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 1rem;
}

.next-step-item:last-child {
  margin-bottom: 0;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 1.5rem;
  font-weight: 700;
  border-radius: 50%;
  flex-shrink: 0;
}

.next-step-item strong {
  display: block;
  color: #1f2937;
  font-size: 1.125rem;
  margin-bottom: 0.25rem;
}

.next-step-item p {
  margin: 0;
  color: #6b7280;
  line-height: 1.6;
}

/* Completion Badge */
.completion-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  padding: 1.5rem;
  border-radius: 12px;
  margin-top: 2rem;
  font-size: 1.25rem;
  font-weight: 700;
}

.completion-badge .material-icons {
  font-size: 2rem;
}

/* Responsive */
@media (max-width: 768px) {
  .goals-grid,
  .challenges-grid,
  .architecture-diagram,
  .module-structure-section .structure-grid,
  .tools-grid-horizontal,
  .practices-grid,
  .summary-grid {
    grid-template-columns: 1fr;
  }

  .flow-steps {
    flex-direction: column;
  }

  .flow-arrow {
    transform: rotate(90deg);
  }

  .flow-step {
    width: 100%;
  }
}
