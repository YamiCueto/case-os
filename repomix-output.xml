.achievement-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.feature-item {
  border-left: 3px solid #8b5cf6;
  padding-left: 1rem;
}

.feature-item strong {
  color: #7c3aed;
  display: block;
  margin-bottom: 0.25rem;
  font-weight: 600;
}

.feature-item p {
  color: #6b7280;
  line-height: 1.6;
  margin: 0;
}

.comparison-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.comparison-item {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 1rem;
}

.comparison-item strong {
  color: #1f2937;
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.125rem;
  font-weight: 600;
}

.comparison-item p {
  color: #6b7280;
  line-height: 1.6;
  margin: 0.25rem 0;
}

.pros-label {
  color: #22c55e;
  font-weight: bold;
  margin-right: 0.5rem;
}

.cons-label {
  color: #ef4444;
  font-weight: bold;
