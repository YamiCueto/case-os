<file path="src/app/clase7-dev-frontend-legacy/clase7-dev-frontend-legacy.component.css">
/* Scenario Box */
.scenario-box {
  display: flex;
  gap: 1.5rem;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 2rem;
  border-radius: 12px;
  margin-bottom: 2rem;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.scenario-icon {
  font-size: 3rem;
  flex-shrink: 0;
}

.scenario-text h3 {
  margin: 0 0 0.75rem 0;
  font-size: 1.5rem;
  font-weight: 700;
}

.scenario-text p {
  margin: 0;
  font-size: 1.05rem;
  line-height: 1.7;
  opacity: 0.95;
}

/* Problems Section */
.problems-section {
  margin-bottom: 2rem;
}

.problems-section > h3 {
  color: #1f2937;
  font-size: 1.5rem;
  margin-bottom: 1.25rem;
  font-weight: 700;
}

.problems-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
}

.problem-card {
  background: white;
  border-radius: 10px;
  padding: 1.5rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  transition: transform 0.2s, box-shadow 0.2s;
}

.problem-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
}

.problem-card[data-color="red"] {
  border-left: 4px solid #ef4444;
}

.problem-card[data-color="orange"] {
  border-left: 4px solid #f97316;
}

.problem-card[data-color="yellow"] {
  border-left: 4px solid #f59e0b;
}

.problem-card[data-color="purple"] {
  border-left: 4px solid #8b5cf6;
}

.problem-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}

.problem-icon {
  font-size: 1.75rem;
}

.problem-header h4 {
  margin: 0;
  font-size: 1.125rem;
  font-weight: 700;
  color: #1f2937;
}

.problem-card p {
  margin: 0;
  color: #4b5563;
  line-height: 1.6;
  font-size: 0.95rem;
}

/* Goals Section */
