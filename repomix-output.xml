<div class="presentation-container" (keydown)="onKeydown($event)" tabindex="0">
  <!-- Back to Study Plan Button -->
  <div class="back-to-menu">
    <a routerLink="/plan-dev-detallado" class="back-btn">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Volver al Plan de Estudio</span>
    </a>
  </div>

  <!-- Navigation Controls -->
  <div class="controls">
    <button (click)="prevSlide()" [disabled]="currentSlide === 0" class="control-btn">
      ← Anterior
    </button>
    <span class="slide-counter">{{ currentSlide + 1 }} / {{ slides.length }}</span>
    <button (click)="nextSlide()" [disabled]="currentSlide === slides.length - 1" class="control-btn">
      Siguiente →
    </button>
  </div>

  <!-- Slide Container -->
  <div class="slide-wrapper">
    <div class="slide" *ngFor="let slide of slides; let i = index" [class.active]="i === currentSlide">

      <!-- Slide 1: Title -->
      <div *ngIf="slide.type === 'title'" class="slide-title">
        <div class="workshop-badge">🔄 TALLER MIGRACIÓN DEV</div>
        <h1>Migración de Código Legacy VB6 / .NET / COBIS a Java 21 + Spring Boot 4.1.0</h1>
        <h2 class="subtitle">Análisis y traducción guiada por IA (Copilot) preservando la lógica de negocio exacta</h2>
        <div class="info-grid">
          <div class="info-item">
            <span class="icon">⏱️</span>
            <span class="label">Duración</span>
            <span class="value">90 minutos</span>
          </div>
          <div class="info-item">
            <span class="icon">📊</span>
            <span class="label">Estructura</span>
            <span class="value">20 min análisis + 70 min migración</span>
          </div>
          <div class="info-item">
            <span class="icon">🎁</span>
            <span class="label">Entregable</span>
            <span class="value">Módulo migrado + tests equivalencia</span>
          </div>
          <div class="info-item">
            <span class="icon">💪</span>
            <span class="label">Nivel</span>
            <span class="value">Avanzado</span>
          </div>
        </div>
        <div class="tech-stack-preview">
          <span class="tech-badge">🟡 VB6 / .NET / COBIS (origen)</span>
          <span class="tech-badge">☕ Java 21 LTS</span>
          <span class="tech-badge">🐘 Gradle 8</span>
          <span class="tech-badge">🍃 Spring Boot 4.1.0</span>
          <span class="tech-badge">🧠 GitHub Copilot</span>
        </div>
      </div>

      <!-- Slide 2: Context -->
      <div *ngIf="slide.type === 'context'" class="slide-content">
        <h2>🏦 El Escenario Real</h2>

        <div class="scenario-card">
          <h3>{{ context.scenario }}</h3>
          <p class="scenario-goal"><strong>🎯 Objetivo:</strong> {{ context.goal }}</p>
        </div>

        <div class="problems-grid">
          <div *ngFor="let sys of context.legacySystems" class="problem-card">
            <div class="problem-header">
              <span class="problem-icon">{{ sys.icon }}</span>
              <h3>{{ sys.name }}</h3>
            </div>
            <ul>
              <li *ngFor="let char of sys.characteristics">{{ char }}</li>
            </ul>
          </div>
        </div>

        <div class="warning-box">
          <strong>⚠️ Desafío:</strong> Migrar sin perder funcionalidad ni introducir bugs — VB6, .NET y COBIS en un solo proyecto Java 21 + Gradle.
        </div>
      </div>

      <!-- Slide 3: Strategy -->
      <div *ngIf="slide.type === 'strategy'" class="slide-content">
        <h2>🎯 Estrategia de Migración</h2>

        <div class="approach-card">
          <h3>{{ strategy.approach }}</h3>
        </div>

        <div class="phases-grid">
          <div *ngFor="let phase of strategy.phases" class="phase-card" [ngClass]="phase.color">
            <div class="phase-header">
              <span class="phase-number">{{ phase.number }}</span>
              <span class="phase-icon">{{ phase.icon }}</span>
            </div>
            <h3>{{ phase.name }}</h3>
            <p>{{ phase.description }}</p>
          </div>
        </div>

        <div class="tip-box">
          <strong>💡 Clave del éxito:</strong> La IA te ayuda a entender código sin documentación y a traducir preservando lógica de negocio.
        </div>
      </div>

      <!-- Slide 4: Analysis -->
      <div *ngIf="slide.type === 'analysis'" class="slide-content">
        <h2>🔍 Fase 1: Análisis con IA</h2>

        <div class="prompt-card">
          <h3>{{ analysisPrompt.title }}</h3>
          <div class="prompt-box">
            <pre>{{ analysisPrompt.prompt }}</pre>
          </div>
        </div>

        <div class="benefits-section">
          <h3>✅ Beneficios de este análisis</h3>
          <div class="benefits-grid">
            <div *ngFor="let benefit of analysisPrompt.benefits" class="benefit-item">
              <span class="benefit-icon">✨</span>
              <p>{{ benefit }}</p>
            </div>
          </div>
        </div>

        <div class="highlight-box">
          <strong>🎯 Resultado:</strong> Documentación completa del módulo legacy antes de escribir una sola línea de código Java.
        </div>
      </div>

      <!-- Slide 5: Migration Steps -->
      <div *ngIf="slide.type === 'migration-steps'" class="slide-content">
        <h2>🔄 Proceso de Migración (5 Pasos)</h2>

        <div class="migration-steps-grid">
          <div *ngFor="let step of migrationSteps" class="migration-step-card" [ngClass]="step.color">
            <div class="step-header">
              <span class="step-number">{{ step.number }}</span>
              <span class="step-icon">{{ step.icon }}</span>
            </div>
            <h3>{{ step.title }}</h3>
            <p class="step-description">{{ step.description }}</p>

            <div class="prompt-preview">
              <strong>Prompt:</strong>
              <code>{{ step.prompt }}</code>
            </div>

            <div class="output-list">
              <strong>Salida esperada:</strong>
              <ul>
                <li *ngFor="let output of step.expectedOutput">{{ output }}</li>
              </ul>
            </div>

            <div class="step-time">⏱️ {{ step.time }}</div>
          </div>
        </div>

        <div class="total-time-box">
          <span class="time-badge">⏰ Tiempo Total Estimado: 70 minutos</span>
        </div>
      </div>

      <!-- Slide 6: Challenge -->
      <div *ngIf="slide.type === 'challenge'" class="slide-content">
        <h2>🎯 Desafío Práctico</h2>

        <div class="challenge-card">
          <div class="challenge-header">
            <h3>{{ challenge.title }}</h3>
            <span class="badge badge-danger">{{ challenge.difficulty }}</span>
          </div>
          <p class="challenge-description">{{ challenge.description }}</p>

          <div class="challenge-section">
            <h4>📜 Código Legacy VB6</h4>
            <div class="code-preview">
              <pre>{{ challenge.legacyCode }}</pre>
            </div>
          </div>

          <div class="challenge-section">
            <h4>📋 Requerimientos</h4>
            <ul class="requirements-list">
              <li *ngFor="let req of challenge.requirements">{{ req }}</li>
            </ul>
          </div>

          <div class="challenge-section">
            <h4>💡 Pistas</h4>
            <ul class="hints-list">
              <li *ngFor="let hint of challenge.hints">{{ hint }}</li>
            </ul>
          </div>

          <div class="challenge-footer">
            <span class="time-badge">⏰ {{ challenge.tiempo }}</span>
          </div>
        </div>
      </div>

      <!-- Slide 7: Best Practices -->
      <div *ngIf="slide.type === 'best-practices'" class="slide-content">
        <h2>✅ Mejores Prácticas en Migración</h2>

        <div class="practices-grid">
          <div class="practices-column">
            <h3 class="practices-header do">✅ SI HACER</h3>
            <div class="practice-item" *ngFor="let practice of bestPractices.dos">
              <h4>{{ practice.title }}</h4>
              <code class="practice-example good">{{ practice.example }}</code>
              <p class="practice-why">{{ practice.why }}</p>
            </div>
          </div>

          <div class="practices-column">
            <h3 class="practices-header dont">❌ NO HACER</h3>
            <div class="practice-item" *ngFor="let practice of bestPractices.donts">
              <h4>{{ practice.title }}</h4>
              <code class="practice-example bad">{{ practice.example }}</code>
              <p class="practice-why">{{ practice.why }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 8: Summary -->
      <div *ngIf="slide.type === 'summary'" class="slide-content">
        <h2>📚 Resumen y Próximos Pasos</h2>

        <div class="summary-grid">
          <div class="summary-card">
            <h3>🎓 Lo que aprendiste</h3>
            <ul>
              <li>Estrategia de migración legacy con IA</li>
              <li>Análisis de código sin documentación</li>
              <li>Traducción preservando lógica de negocio</li>
              <li>Proceso de 5 pasos: Análisis → Entity → Service → Controller → Tests</li>
            </ul>
          </div>

          <div class="summary-card">
            <h3>📖 Próxima Clase</h3>
            <p><strong>Clase 4:</strong> Integración con APIs Externas (Bureau de Crédito)</p>
            <p>Aprenderás a integrar servicios externos usando IA para generar clientes y mappers</p>
          </div>

          <div class="summary-card">
            <h3>📚 Recursos</h3>
            <ul>
              <li>Guía de migración VB6 → Java</li>
              <li>Patrones de traducción comunes</li>
              <li>Checklist de validación post-migración</li>
              <li>Ejemplos de prompts para análisis</li>
            </ul>
          </div>

          <div class="summary-card">
            <h3>🏋️ Tarea</h3>
            <p>Completa el desafío: migrar módulo AperturaCuentas</p>
            <p>Documenta diferencias encontradas entre VB6 y Spring Boot</p>
          </div>
        </div>

        <div class="quote-box">
          <p class="quote-text">"La IA no reemplaza tu conocimiento del dominio, lo amplifica para entender sistemas legacy rápidamente"</p>
          <p class="quote-author">- Legacy Modernization Best Practices</p>
        </div>
      </div>

    </div>
  </div>
</div>
