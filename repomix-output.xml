<file path="src/app/clase6-dev-modulo-angular/clase6-dev-modulo-angular.component.html">
<div class="presentation-container">
  <!-- Back to Study Plan Button -->
  <div class="back-to-menu">
    <a routerLink="/plan-dev-detallado" class="back-btn">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Volver al Plan de Estudio</span>
    </a>
  </div>

  <!-- Navigation Controls -->
  <div class="controls">
    <button (click)="previousSlide()" [disabled]="currentSlide === 0" class="control-btn">
      ← Anterior
    </button>
    <span class="slide-counter">{{ currentSlide + 1 }} / {{ slides.length }}</span>
    <button (click)="nextSlide()" [disabled]="currentSlide === slides.length - 1" class="control-btn">
      Siguiente →
    </button>
  </div>

  <!-- Slide Container -->
  <div class="slide-wrapper">
    <div class="slide" *ngFor="let slide of slides; let i = index" [class.active]="i === currentSlide">

      <!-- Slide 1: Title -->
      <div *ngIf="slide.type === 'title'" class="slide-title">
        <div class="workshop-badge">🎨 TALLER FRONTEND DEV</div>
        <h1>Frontend Moderno con Angular 19+ Signals & Tailwind v4</h1>
        <h2 class="subtitle">Desarrolla interfaces ultra-reactivas con Signals, Standalone Components y Tailwind CSS v4 asistido por IA</h2>
        <div class="info-grid">
          <div class="info-item">
            <span class="icon">⏱️</span>
            <span class="label">Duración</span>
            <span class="value">60 minutos</span>
          </div>
          <div class="info-item">
            <span class="icon">📊</span>
            <span class="label">Estructura</span>
            <span class="value">10 min intro + 50 min código</span>
          </div>
          <div class="info-item">
            <span class="icon">🎁</span>
            <span class="label">Entregable</span>
            <span class="value">Módulo Angular 19 Signals completo</span>
          </div>
          <div class="info-item">
            <span class="icon">💪</span>
            <span class="label">Nivel</span>
            <span class="value">Intermedio</span>
          </div>
        </div>
        <div class="tech-stack-preview">
          <span class="tech-badge">🅰️ Angular 19+</span>
          <span class="tech-badge">⚡ Signals</span>
          <span class="tech-badge">🔷 TypeScript</span>
          <span class="tech-badge">🎨 Tailwind CSS v4</span>
        </div>
      </div>

      <!-- Slide 2: Context -->
      <div *ngIf="slide.type === 'context'" class="slide-content">
        <h2>🎯 El Desafío del Frontend Moderno</h2>

        <div class="scenario-box">
          <h3>{{ context.scenario }}</h3>
        </div>

        <div class="goals-section">
          <h3>Objetivos del Módulo Angular</h3>
          <div class="goals-grid">
            <div *ngFor="let goal of context.goals" class="goal-card">
              <span class="goal-icon">✅</span>
              <p>{{ goal }}</p>
            </div>
          </div>
        </div>

        <div class="challenges-grid">
          <div *ngFor="let challenge of context.challenges" class="challenge-card">
            <div class="challenge-header">
              <span class="material-icons" [style.color]="challenge.color === 'orange' ? '#f59e0b' : challenge.color === 'purple' ? '#a855f7' : challenge.color === 'red' ? '#ef4444' : '#3b82f6'">{{ challenge.icon }}</span>
              <h4>{{ challenge.title }}</h4>
            </div>
            <p>{{ challenge.description }}</p>
          </div>
        </div>

        <div class="solution-box">
          <strong>💡 Solución:</strong> Usa IA para generar estructura completa del módulo con componentes, servicios y routing configurados.
        </div>
      </div>

      <!-- Slide 3: Architecture -->
      <div *ngIf="slide.type === 'architecture'" class="slide-content">
        <h2>🏗️ Arquitectura del Módulo Angular</h2>

        <div class="architecture-diagram">
          <div *ngFor="let layer of architectureLayers" class="architecture-layer">
            <div class="layer-header">
              <span class="layer-icon">{{ layer.icon }}</span>
              <h3>{{ layer.name }}</h3>
            </div>
            <p class="layer-description">{{ layer.description }}</p>
            <div class="layer-files">
              <span *ngFor="let file of layer.files" class="file-badge">{{ file }}</span>
            </div>
          </div>
        </div>

        <div class="flow-diagram">
          <h3>Flujo de Datos</h3>
          <div class="flow-steps">
            <div class="flow-step">
              <span class="step-number">1</span>
              <div class="step-content">
                <strong>Usuario interactúa</strong>
                <p>Click en botón o formulario</p>
              </div>
            </div>
            <span class="flow-arrow">→</span>
            <div class="flow-step">
              <span class="step-number">2</span>
              <div class="step-content">
                <strong>Componente llama Service</strong>
                <p>clientesService.getClientes()</p>
              </div>
            </div>
            <span class="flow-arrow">→</span>
            <div class="flow-step">
              <span class="step-number">3</span>
              <div class="step-content">
                <strong>Service hace HTTP</strong>
                <p>HttpClient con interceptores</p>
              </div>
            </div>
            <span class="flow-arrow">→</span>
            <div class="flow-step">
              <span class="step-number">4</span>
              <div class="step-content">
                <strong>Actualiza UI</strong>
                <p>async pipe + change detection</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 4: Service Prompt -->
      <div *ngIf="slide.type === 'service-prompt'" class="slide-content">
        <h2>🔌 Generar Service con HttpClient</h2>

        <div class="prompt-card">
          <h4>
            <span class="material-icons">api</span>
            {{ servicePrompt.title }}
          </h4>

          <div class="prompt-section">
            <strong>ROL:</strong>
            <p>{{ servicePrompt.role }}</p>
          </div>

          <div class="prompt-section">
            <strong>CONTEXTO:</strong>
            <ul>
              <li *ngFor="let ctx of servicePrompt.context">{{ ctx }}</li>
            </ul>
          </div>

          <div class="prompt-section">
            <strong>TAREA:</strong>
            <ol>
              <li *ngFor="let task of servicePrompt.task">{{ task }}</li>
            </ol>
          </div>

          <div class="prompt-section">
            <strong>OUTPUT ESPERADO:</strong>
            <ul>
              <li *ngFor="let output of servicePrompt.expectedOutput">{{ output }}</li>
            </ul>
          </div>
        </div>

        <div class="example-box">
          <h4>Ejemplo: ClientesService Generado</h4>
          <pre><code>&#64;Injectable({{ '{' }} providedIn: 'root' {{ '}' }})
export class ClientesService {{ '{' }}
  private baseUrl = environment.apiUrl + '/clientes';
  private loadingSubject = new BehaviorSubject&lt;boolean&gt;(false);
  loading$ = this.loadingSubject.asObservable();

  constructor(private http: HttpClient) {{ '{' }} {{ '}' }}

  getClientes(page = 0, size = 10): Observable&lt;PageResponse&lt;Cliente&gt;&gt; {{ '{' }}
    const params = new HttpParams()
      .set('page', page.toString())
      .set('size', size.toString());

    return this.http.get&lt;PageResponse&lt;Cliente&gt;&gt;(this.baseUrl, {{ '{' }} params {{ '}' }})
      .pipe(
        catchError(this.handleError)
      );
  {{ '}' }}

  private handleError(error: HttpErrorResponse) {{ '{' }}
    return throwError(() =&gt; error);
  {{ '}' }}
{{ '}' }}</code></pre>
        </div>
      </div>

      <!-- Slide 5: Component Prompt -->
      <div *ngIf="slide.type === 'component-prompt'" class="slide-content">
        <h2>🧩 Generar Componentes CRUD</h2>

        <div class="prompt-card">
          <h4>
            <span class="material-icons">widgets</span>
            {{ componentPrompt.title }}
          </h4>

          <div class="prompt-section">
            <strong>ROL:</strong>
            <p>{{ componentPrompt.role }}</p>
          </div>

          <div class="prompt-section">
            <strong>CONTEXTO:</strong>
            <ul>
              <li *ngFor="let ctx of componentPrompt.context">{{ ctx }}</li>
            </ul>
          </div>

          <div class="prompt-section">
            <strong>TAREA:</strong>
            <ol>
              <li *ngFor="let task of componentPrompt.task">{{ task }}</li>
            </ol>
          </div>

          <div class="prompt-section">
            <strong>OUTPUT ESPERADO:</strong>
            <ul>
              <li *ngFor="let output of componentPrompt.expectedOutput">{{ output }}</li>
            </ul>
          </div>
        </div>

        <div class="tools-section">
          <h3>Herramientas Angular</h3>
          <div class="tools-grid-horizontal">
            <div *ngFor="let tool of angularTools" class="tool-card-compact">
              <h4>{{ tool.name }}</h4>
              <p>{{ tool.description }}</p>
              <div *ngIf="tool.commands" class="commands-list">
                <code *ngFor="let cmd of tool.commands">{{ cmd }}</code>
              </div>
              <div *ngIf="tool.components" class="components-chips">
                <span *ngFor="let comp of tool.components" class="chip">{{ comp }}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 6: Challenge -->
      <div *ngIf="slide.type === 'challenge'" class="slide-content">
        <h2>
          <span class="material-icons">emoji_events</span>
          {{ challenge.title }}
        </h2>

        <div class="challenge-description">
          <p>{{ challenge.description }}</p>
        </div>

        <div class="requirements-section">
          <h3>Requisitos Técnicos</h3>
          <ul class="requirements-list">
            <li *ngFor="let req of challenge.requirements">
              <span class="material-icons">check_circle</span>
              {{ req }}
            </li>
          </ul>
        </div>

        <div class="module-structure-section">
          <h3>Estructura del Módulo</h3>
          <div class="structure-grid">
            <div class="structure-card">
              <h4>🗺️ Routing</h4>
              <ul>
                <li *ngFor="let route of challenge.moduleStructure.routing">{{ route }}</li>
              </ul>
            </div>
            <div class="structure-card">
              <h4>🧩 Components</h4>
              <ul>
                <li *ngFor="let comp of challenge.moduleStructure.components">{{ comp }}</li>
              </ul>
            </div>
            <div class="structure-card">
              <h4>🔌 Services</h4>
              <ul>
                <li *ngFor="let service of challenge.moduleStructure.services">{{ service }}</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="hints-section">
          <h4>
            <span class="material-icons">lightbulb</span>
            Pistas
          </h4>
          <ul class="hints-list">
            <li *ngFor="let hint of challenge.hints">{{ hint }}</li>
          </ul>
        </div>

        <div class="time-estimate">
          <span class="material-icons">schedule</span>
          Tiempo estimado: {{ challenge.timeEstimate }}
        </div>
      </div>

      <!-- Slide 7: Best Practices -->
      <div *ngIf="slide.type === 'best-practices'" class="slide-content">
        <h2>✅ Mejores Prácticas Angular</h2>

        <div class="practices-grid">
          <div *ngFor="let category of bestPractices" class="practice-category">
            <h3>
              <span class="material-icons">star</span>
              {{ category.category }}
            </h3>
            <ul class="practices-list">
              <li *ngFor="let practice of category.practices">
                <span class="material-icons">arrow_right</span>
                {{ practice }}
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Slide 8: Summary -->
      <div *ngIf="slide.type === 'summary'" class="slide-content">
        <h2>📚 Resumen</h2>

        <div class="summary-grid">
          <div class="summary-card">
            <span class="material-icons">account_tree</span>
            <h3>Arquitectura</h3>
            <ul>
              <li>Módulo con lazy loading</li>
              <li>Smart vs Dumb components</li>
              <li>Service layer con HttpClient</li>
              <li>Interceptores globales</li>
            </ul>
          </div>

          <div class="summary-card">
            <span class="material-icons">code</span>
            <h3>Componentes Clave</h3>
            <ul>
              <li>Lista: tabla Material + filtros</li>
              <li>Form: reactive forms + validaciones</li>
              <li>Detalle: vista solo lectura</li>
              <li>Service: CRUD con RxJS</li>
            </ul>
          </div>

          <div class="summary-card">
            <span class="material-icons">psychology</span>
            <h3>Con IA Generas</h3>
            <ul>
              <li>Estructura completa del módulo</li>
              <li>Formularios con validaciones</li>
              <li>Manejo de errores global</li>
              <li>Tests unitarios básicos</li>
            </ul>
          </div>
        </div>

        <div class="next-steps">
          <h3>Próximos Pasos</h3>
          <div class="next-step-item">
            <span class="step-number">1</span>
            <div>
              <strong>Implementa el módulo</strong>
              <p>Usa los prompts para generar servicio y componentes</p>
            </div>
          </div>
          <div class="next-step-item">
            <span class="step-number">2</span>
            <div>
              <strong>Integra con backend</strong>
              <p>Conecta con API REST de Clase 2</p>
            </div>
          </div>
          <div class="next-step-item">
            <span class="step-number">3</span>
            <div>
              <strong>Refina y personaliza</strong>
              <p>Ajusta estilos, validaciones y UX</p>
            </div>
          </div>
        </div>

        <div class="completion-badge">
          <span class="material-icons">check_circle</span>
          <span>Clase 6 completada</span>
        </div>
      </div>

    </div>
  </div>
</div>
