            <pre class="code-block legacy-code"><code>{{ challenge.legacyCode }}</code></pre>
          </div>

          <div class="challenge-section">
            <h4>✅ Requerimientos</h4>
            <ul>
              <li *ngFor="let req of challenge.requirements">{{ req }}</li>
            </ul>
          </div>

          <div class="challenge-section">
            <h4>💡 Pistas</h4>
            <ul>
              <li *ngFor="let hint of challenge.hints">{{ hint }}</li>
