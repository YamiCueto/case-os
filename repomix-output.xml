                  </svg>
                  <span>Click para ver guía completa</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="mt-8 bg-gradient-to-r from-amber-50 to-yellow-50 border-2 border-amber-200 rounded-lg p-6">
        <h4 class="text-xl font-bold text-amber-800 mb-3">⚡ Enlaces Rápidos</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href="https://code.visualstudio.com/" target="_blank" rel="noopener noreferrer"
             class="bg-white rounded-lg p-3 hover:shadow-md transition-all flex items-center gap-3">
            <span class="text-2xl">💻</span>
            <span class="text-sm font-semibold text-gray-700">VS Code</span>
          </a>
          <a href="https://www.python.org/downloads/" target="_blank" rel="noopener noreferrer"
             class="bg-white rounded-lg p-3 hover:shadow-md transition-all flex items-center gap-3">
