          <span>Verificación de Instalación</span>
        </h4>
        <ul class="list-disc list-inside text-green-700 space-y-2">
          <li *ngFor="let check of selectedGuide.verification" class="font-mono text-sm">{{check}}</li>
        </ul>
      </div>

      <!-- Troubleshooting -->
      <div class="mb-6">
        <h4 class="text-xl font-bold text-gray-800 mb-3 flex items-center gap-2">
