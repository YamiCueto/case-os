              <h4>{{ step.title }}</h4>
            </div>
            <p class="step-description">{{ step.description }}</p>
            <div class="prompt-mini">
              <h5>
                <span class="material-icons">psychology</span>
                Prompt Copilot:
              </h5>
              <pre><code>{{ step.promptExample }}</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 5: Reactive Forms -->
      <div *ngIf="slide.type === 'reactive-forms'" class="slide-content">
        <h2>{{ reactiveForms.title }}</h2>

        <div class="equivalences-table">
          <h4>Tabla de Equivalencias VB6 → Angular 22</h4>
          <table class="dto-table">
            <thead>
              <tr>
                <th>VB6 / .NET</th>
                <th>Angular 22</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let eq of reactiveForms.equivalences">
                <td><code>{{ eq.vb6 }}</code></td>
                <td><code>{{ eq.angular }}</code></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="example-box">
          <h4>Ejemplo completo — Equivalente al Form VB6 de Apertura de Cuenta</h4>
          <pre><code>{{ reactiveForms.codeExample }}</code></pre>
        </div>
      </div>

      <!-- Slide 6: Challenge -->
      <div *ngIf="slide.type === 'challenge'" class="slide-content">
        <h2>
          <span class="material-icons">emoji_events</span>
          {{ challenge.title }}
        </h2>

        <div class="challenge-description">
          <p>{{ challenge.description }}</p>
        </div>

        <div class="legacy-code-section">
          <h4>
            <span class="material-icons">history</span>
            Código VB6 Original a Migrar
          </h4>
          <pre class="legacy-code"><code>{{ challenge.legacyVb6Form }}</code></pre>
        </div>

        <div class="requirements-section">
          <h3>Requisitos Técnicos</h3>
          <ul class="requirements-list">
            <li *ngFor="let req of challenge.requirements">
              <span class="material-icons">check_circle</span>
              {{ req }}
            </li>
          </ul>
        </div>

        <div class="prompt-card">
          <h4>
            <span class="material-icons">psychology</span>
            Prompt Base para Copilot
          </h4>
          <ul class="prompt-list">
            <li *ngFor="let p of challenge.promptBase">{{ p }}</li>
          </ul>
        </div>

        <div class="time-estimate">
          <span class="material-icons">schedule</span>
          Tiempo estimado: {{ challenge.timeEstimate }}
        </div>
      </div>

      <!-- Slide 7: Best Practices -->
      <div *ngIf="slide.type === 'best-practices'" class="slide-content">
        <h2>Mejores Prácticas — Angular 22 + Migración UI</h2>

        <div class="practices-grid">
          <div *ngFor="let category of bestPractices" class="practice-category">
            <h3>
              <span class="material-icons">star</span>
              {{ category.category }}
            </h3>
            <ul class="practices-list">
              <li *ngFor="let practice of category.practices">
                <span class="material-icons">arrow_right</span>
                {{ practice }}
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Slide 8: Summary -->
      <div *ngIf="slide.type === 'summary'" class="slide-content">
        <h2>Resumen — Migración UI Legacy a Angular 22</h2>

        <div class="summary-grid">
          <div class="summary-card">
            <span class="material-icons">compare_arrows</span>
            <h3>Legado → Moderno</h3>
            <ul>
              <li>VB6 Form → Standalone Component</li>
              <li>Eventos VB6 (Click, Change) → Reactive Forms</li>
              <li>Variables globales Form → signal()</li>
              <li>Binding manual (txtNombre.Text) → Two-way data binding</li>
              <li>MsgBox / MessageBox → signal error + &#64;if en template</li>
            </ul>
          </div>

          <div class="summary-card">
            <span class="material-icons">inventory</span>
            <h3>Stack Angular 22</h3>
            <ul>
              <li>signal() / computed() / effect() — sin Zone.js</li>
              <li>&#64;for / &#64;if — nueva sintaxis de control flow</li>
              <li>ReactiveFormsModule + Validators</li>
              <li>inject() — sin constructor DI verboso</li>
              <li>HttpClient tipado con interfaces Java-compatible</li>
            </ul>
          </div>

          <div class="summary-card">
            <span class="material-icons">psychology</span>
            <h3>Prompting con Copilot</h3>
            <ul>
              <li>Pegar código VB6/WinForms como contexto</li>
              <li>Especificar "Angular 22, &#64;for y &#64;if — no *ngFor"</li>
              <li>Pedir "signals para estado — no Subject ni BehaviorSubject"</li>
              <li>Pedir "standalone — sin NgModule"</li>
              <li>Generar .ts primero, template en segundo prompt</li>
            </ul>
          </div>
        </div>

        <div class="completion-badge">
          <span class="material-icons">check_circle</span>
          <span>Clase 11 completada — UI Legacy migrada a Angular 22 Signals</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Slide Indicators -->
  <div class="slide-indicators">
    <span
      *ngFor="let slide of slides; let i = index"
      class="indicator"
      [class.active]="currentSlide === i"
      (click)="goToSlide(i)">
    </span>
  </div>

</div>
</file>

