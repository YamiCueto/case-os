  margin: 0 0 1rem 0;
}

.hints-section h4 .material-icons {
  color: #f59e0b;
  font-size: 1.5rem;
}

.hints-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.hints-list li {
  padding: 0.5rem 0;
  padding-left: 1.5rem;
  position: relative;
