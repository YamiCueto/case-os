<file path="src/app/clase1-dev-fundamentos/clase1-dev-fundamentos.component.html">
<div class="presentation-container" (keydown)="onKeydown($event)" tabindex="0">
  <!-- Back to Study Plan Button -->
  <div class="back-to-menu">
    <a routerLink="/study-plan" class="back-btn">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Volver al Plan de Estudio</span>
    </a>
  </div>

  <!-- Navigation Controls -->
  <div class="controls">
    <button (click)="prevSlide()" [disabled]="currentSlide === 0" class="control-btn">
      ← Anterior
    </button>
    <span class="slide-counter">{{ currentSlide + 1 }} / {{ slides.length }}</span>
    <button (click)="nextSlide()" [disabled]="currentSlide === slides.length - 1" class="control-btn">
      Siguiente →
    </button>
  </div>

  <!-- Slide Container -->
  <div class="slide-wrapper">
    <div class="slide" *ngFor="let slide of slides; let i = index" [class.active]="i === currentSlide">

      <!-- Slide 1: Title -->
      <div *ngIf="slide.type === 'title'" class="slide-title">
        <div class="workshop-badge">💻 CLASE INAUGURAL DEV</div>
        <h1>Fundamentos de IA Generativa para Developers</h1>
        <h2 class="subtitle">De Usuario Casual a Prompt Engineer Profesional</h2>
        <div class="info-grid">
          <div class="info-item">
            <span class="icon">⏱️</span>
            <span class="label">Duración</span>
            <span class="value">60 minutos</span>
          </div>
          <div class="info-item">
            <span class="icon">📊</span>
            <span class="label">Estructura</span>
            <span class="value">20 min teoría + 40 min práctica</span>
          </div>
          <div class="info-item">
            <span class="icon">🎁</span>
            <span class="label">Entregable</span>
            <span class="value">Análisis módulo legacy</span>
          </div>
          <div class="info-item">
            <span class="icon">💪</span>
            <span class="label">Nivel</span>
            <span class="value">Fundamentos</span>
          </div>
        </div>
      </div>

      <!-- Slide 2: Theory - Conceptos -->
      <div *ngIf="slide.type === 'theory'" class="slide-content">
        <h2>🧠 Conceptos Fundamentales</h2>
        <div class="theory-grid">
          <div *ngFor="let concepto of conceptos" class="theory-card" [ngClass]="concepto.color">
            <div class="theory-icon">{{ concepto.icon }}</div>
            <h3>{{ concepto.title }}</h3>
            <p>{{ concepto.description }}</p>
          </div>
        </div>
        <div class="warning-box">
          <strong>🎯 Objetivo:</strong> Entender qué es IA Generativa y cómo aplicarla específicamente a desarrollo de software.
        </div>
      </div>

      <!-- Slide 3: Tools -->
      <div *ngIf="slide.type === 'tools'" class="slide-content">
        <h2>🛠️ Herramientas para Developers</h2>
        <div class="tools-grid">
          <div *ngFor="let tool of tools" class="tool-card" [ngClass]="tool.color">
            <div class="tool-header">
              <span class="tool-icon">{{ tool.icon }}</span>
              <h3>{{ tool.name }}</h3>
            </div>
            <p class="tool-description">{{ tool.description }}</p>
            <div class="tool-details">
              <div class="tool-price">💰 {{ tool.price }}</div>
              <div class="tool-best-for">🎯 {{ tool.bestFor }}</div>
            </div>
          </div>
        </div>
        <div class="tip-box">
          <strong>💡 Recomendación:</strong> Comienza con ChatGPT/Claude gratis. Cuando domines prompts, invierte en Copilot/Cursor.
        </div>
      </div>

      <!-- Slide 4: Prompt Engineering -->
      <div *ngIf="slide.type === 'prompts'" class="slide-content">
        <h2>✍️ El Mito del "ChatGPT hace todo el código"</h2>

        <div class="comparison-grid">
          <!-- Casual -->
          <div class="comparison-card bad">
            <h3>{{ promptExamples.casual.title }}</h3>
            <div class="prompt-box bad">
              <pre>{{ promptExamples.casual.prompt }}</pre>
            </div>
            <ul class="problems-list">
              <li *ngFor="let problem of promptExamples.casual.problems">❌ {{ problem }}</li>
            </ul>
          </div>

          <!-- Professional -->
          <div class="comparison-card good">
            <h3>{{ promptExamples.professional.title }}</h3>
            <div class="prompt-box good">
              <pre>{{ promptExamples.professional.prompt }}</pre>
            </div>
            <ul class="benefits-list">
              <li *ngFor="let benefit of promptExamples.professional.benefits">✅ {{ benefit }}</li>
            </ul>
          </div>
        </div>

        <div class="highlight-box">
          <strong>⚡ CLAVE:</strong> La IA multiplica tu productividad cuando le das contexto preciso del stack, arquitectura y restricciones del proyecto.
        </div>
      </div>

      <!-- Slide 5: Limitations -->
      <div *ngIf="slide.type === 'limitations'" class="slide-content">
        <h2>⚠️ Limitaciones y Cómo Mitigarlas</h2>
        <div class="limitations-grid">
          <div *ngFor="let limitation of limitations" class="limitation-card" [ngClass]="limitation.color">
            <div class="limitation-header">
              <span class="limitation-icon">{{ limitation.icon }}</span>
              <h3>{{ limitation.title }}</h3>
            </div>
            <p class="limitation-description">{{ limitation.description }}</p>
            <div class="solution-box">
              <strong>💡 Solución:</strong> {{ limitation.solution }}
            </div>
          </div>
        </div>
        <div class="warning-box">
          <strong>🔐 Seguridad:</strong> Nunca compartas código propietario o secretos con IAs públicas. Usa herramientas enterprise si es necesario.
        </div>
      </div>

      <!-- Slide 6: Challenge -->
      <div *ngIf="slide.type === 'challenge'" class="slide-content">
        <h2>🎯 Ejercicio Práctico</h2>
        <div class="challenge-container">
          <div class="challenge-header">
            <span class="badge-difficulty" [ngClass]="'badge-' + challenge.difficulty.toLowerCase()">
              {{ challenge.difficulty }}
            </span>
            <h3>{{ challenge.title }}</h3>
          </div>

          <p class="challenge-description">{{ challenge.description }}</p>

          <div class="challenge-section">
            <h4>📋 Contexto</h4>
            <ul>
              <li *ngFor="let item of challenge.context">{{ item }}</li>
            </ul>
          </div>

          <div class="challenge-section">
            <h4>✅ Requerimientos</h4>
            <ul>
              <li *ngFor="let req of challenge.requirements">{{ req }}</li>
            </ul>
          </div>

          <div class="challenge-section">
            <h4>💡 Pistas</h4>
            <ul>
              <li *ngFor="let hint of challenge.hints">{{ hint }}</li>
            </ul>
          </div>

          <div class="timer-box">
            <span class="timer-icon">⏱️</span>
            <span class="timer-text">Tiempo sugerido: 30 minutos</span>
          </div>
        </div>
      </div>

      <!-- Slide 7: Best Practices -->
      <div *ngIf="slide.type === 'best-practices'" class="slide-content">
        <h2>🚀 Mejores Prácticas</h2>

        <div class="practices-grid">
          <!-- DO's -->
          <div class="practices-column">
            <h3 class="practices-title do">✅ DO's (Hacer)</h3>
            <div class="practice-item" *ngFor="let practice of bestPractices.dos">
              <h4>{{ practice.title }}</h4>
              <div class="practice-example">{{ practice.example }}</div>
              <p>{{ practice.description }}</p>
            </div>
          </div>

          <!-- DON'Ts -->
          <div class="practices-column">
            <h3 class="practices-title dont">❌ DON'Ts (Evitar)</h3>
            <div class="practice-item" *ngFor="let practice of bestPractices.donts">
              <h4>{{ practice.title }}</h4>
              <div class="practice-example">{{ practice.example }}</div>
              <p>{{ practice.description }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 8: Summary -->
      <div *ngIf="slide.type === 'summary'" class="slide-content">
        <h2>📝 Resumen y Próximos Pasos</h2>

        <div class="summary-grid">
          <div class="summary-card bg-blue-50">
            <h3>🎯 Aprendiste Hoy</h3>
            <ul>
              <li>Diferencia entre IA, ML y GenIA</li>
              <li>Cómo funcionan los LLMs</li>
              <li>Herramientas disponibles para developers</li>
              <li>Prompt Engineering profesional</li>
              <li>Limitaciones y cómo mitigarlas</li>
            </ul>
          </div>

          <div class="summary-card bg-green-50">
            <h3>🚀 Próxima Clase</h3>
            <p><strong>Clase 2: Taller - Generación de Microservicio Spring Boot Completo</strong></p>
            <ul>
              <li>Crear microservicio desde cero con IA</li>
              <li>Arquitectura hexagonal</li>
              <li>Tests con cobertura >80%</li>
              <li>Listo para producción</li>
            </ul>
          </div>

          <div class="summary-card bg-purple-50">
            <h3>📚 Recursos</h3>
            <ul>
              <li>📖 Prompt Engineering Guide</li>
              <li>💬 Canal Slack: #ia-generativa-devs</li>
              <li>🎥 Grabación de esta clase</li>
              <li>📄 Plantillas de prompts reutilizables</li>
            </ul>
          </div>

          <div class="summary-card bg-orange-50">
            <h3>💡 Tarea</h3>
            <ul>
              <li>Practica con tu IDE favorito</li>
              <li>Instala GitHub Copilot o Cursor</li>
              <li>Analiza un módulo legacy de tu proyecto</li>
              <li>Comparte resultados en Slack</li>
            </ul>
          </div>
        </div>

        <div class="quote-box">
          <p class="quote">"La IA es tu copiloto, no tu piloto."</p>
          <p class="quote-author">Tú sigues siendo el desarrollador senior que toma decisiones arquitectónicas, valida código y garantiza calidad.</p>
        </div>
      </div>

    </div>
  </div>
</div>
</file>

