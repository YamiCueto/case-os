          <div class="flex gap-2 flex-wrap">
            <span *ngFor="let clase of selectedGuide.relatedClasses"
                  class="bg-purple-200 text-purple-800 px-2 py-1 rounded text-xs font-semibold">
              {{clase}}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Guides List View (when no guide selected) -->
    <div *ngIf="!selectedGuide">
      <div class="mb-6">
        <h3 class="text-3xl font-bold text-gray-800 mb-2">📚 Guías de Instalación Completas</h3>
        <p class="text-gray-600 mb-4">
          Instrucciones detalladas paso a paso para instalar todas las herramientas necesarias del curso.
          Cada guía incluye verificaciones, troubleshooting y tips específicos para Windows.
        </p>

        <!-- Expand/Collapse All Controls -->
        <div class="flex gap-3 mb-4">
          <button (click)="expandAllCategories()"
