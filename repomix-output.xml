  border-bottom: 2px solid #e5e7eb;
}

.practice-category .material-icons {
  font-size: 1.8rem;
}

.practices-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 1rem;
}

.practices-list li {
  display: flex;
  align-items: start;
  gap: 0.75rem;
  padding: 1rem;
  background: #f9fafb;
  border-radius: 8px;
  line-height: 1.6;
