            <h4>⚠️ Problemas:</h4>
            <ul>
              <li *ngFor="let problem of unsubscribePatterns.legacy.problems">{{ problem }}</li>
            </ul>
          </div>
        </div>

        <div class="patterns-comparison">
          <div class="pattern-column">
            <h3>{{ unsubscribePatterns.takeUntilDestroyed.title }}</h3>
            <pre class="code-block"><code>{{ unsubscribePatterns.takeUntilDestroyed.code }}</code></pre>
            <div class="benefits-list">
              <h4>✅ Beneficios:</h4>
              <ul>
                <li *ngFor="let benefit of unsubscribePatterns.takeUntilDestroyed.benefits">{{ benefit }}</li>
              </ul>
            </div>
          </div>

          <div class="pattern-column">
            <h3>{{ unsubscribePatterns.takeUntil.title }}</h3>
            <pre class="code-block"><code>{{ unsubscribePatterns.takeUntil.code }}</code></pre>
            <div class="benefits-list">
              <h4>✅ Beneficios:</h4>
              <ul>
                <li *ngFor="let benefit of unsubscribePatterns.takeUntil.benefits">{{ benefit }}</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 5: Change Detection Strategy -->
      <div *ngIf="slide.type === 'change-detection'" class="slide-content">
        <h2>⚡ Change Detection Strategy</h2>

        <div class="cd-section default-section">
          <h3>{{ changeDetectionStrategy.default.title }}</h3>
          <p class="cd-description">{{ changeDetectionStrategy.default.description }}</p>
          <pre class="code-block"><code>{{ changeDetectionStrategy.default.code }}</code></pre>
          <div class="problems-list">
