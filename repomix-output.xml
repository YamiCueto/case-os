/* Slide 1: Title enhancements */
.slide-title .subtitle {
  font-size: 1.5rem;
  color: #667eea;
  font-weight: 600;
  margin: 1rem 0;
  text-align: center;
}

.slide-title .description {
  font-size: 1.125rem;
  color: #4b5563;
  line-height: 1.8;
  max-width: 800px;
  margin: 1.5rem auto;
  text-align: center;
}

.title-icon {
  font-size: 5rem;
  text-align: center;
  margin: 2rem 0;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

.info-grid .info-item {
  transition: all 0.3s ease;
  cursor: default;
}

.info-grid .info-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 24px rgba(102, 126, 234, 0.2);
  border-left-color: #f093fb;
}

.info-grid .info-icon {
  display: inline-block;
  transition: transform 0.3s ease;
}

.info-grid .info-item:hover .info-icon {
  transform: scale(1.2) rotate(5deg);
}

/* Slide 2: Context - Scenario box */
.scenario-box {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12px;
  padding: 2rem;
  margin: 2rem 0;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  color: white;
}

.scenario-icon {
  font-size: 3rem;
  flex-shrink: 0;
}

.scenario-box p {
  font-size: 1.125rem;
  line-height: 1.7;
  margin: 0;
}

/* Reasons grid */
.reasons-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin: 2rem 0;
}

.reason-card {
  background: white;
  border-radius: 12px;
  padding: 2rem;
  border-left: 4px solid #6366f1;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s, box-shadow 0.2s;
}

.reason-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

.reason-card[data-color="blue"] {
