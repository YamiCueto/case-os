<file path=".github/workflows/deploy.yml">
name: Deploy Angular App to GitHub Pages

on:
  push:
    branches:
      - main

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: 'pages'
  cancel-in-progress: true

jobs:
  build-and-deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'

      - name: Install Dependencies
        run: npm ci

      - name: Build Angular App for GitHub Pages
        run: npx ng build --configuration production --base-href /curso-ia-generativa/

      - name: Copy index.html to 404.html for Fallback
        run: cp dist/curso-ia-generativa/browser/index.html dist/curso-ia-generativa/browser/404.html

      - name: Setup Pages
        uses: actions/configure-pages@v5

      - name: Upload Artifacts
        uses: actions/upload-pages-artifact@v3
        with:
          path: 'dist/curso-ia-generativa/browser'

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
</file>

<file path="src/app/clase10-dev-fastapi/clase10-dev-fastapi.component.html">
<div class="presentation-container">
  <!-- Back to Study Plan Button -->
  <div class="back-to-menu">
    <a routerLink="/plan-dev-detallado" class="back-btn">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Volver al Plan de Estudio</span>
    </a>
  </div>

  <!-- Navigation Controls -->
  <div class="controls">
    <button (click)="previousSlide()" [disabled]="currentSlide === 0" class="control-btn">
      ← Anterior
    </button>
    <span class="slide-counter">{{ currentSlide + 1 }} / {{ slides.length }}</span>
    <button (click)="nextSlide()" [disabled]="currentSlide === slides.length - 1" class="control-btn">
      Siguiente →
    </button>
  </div>

  <!-- Slide Container -->
  <div class="slide-wrapper">
    <div class="slide" *ngFor="let slide of slides; let i = index" [class.active]="i === currentSlide">

      <!-- Slide 1: Title -->
      <div *ngIf="slide.type === 'title'" class="slide-title">
        <div class="workshop-badge">🧠 CLASE 10 DEV</div>
        <div class="title-icon">{{ titleSlide.icon }}</div>
        <h1>{{ titleSlide.title }}</h1>
        <p class="subtitle">{{ titleSlide.subtitle }}</p>
        <div class="info-grid">
          <div class="info-item">
            <span class="info-icon">🎯</span>
            <span class="info-label">Objetivo</span>
            <span class="info-value">RAG sobre documentación legacy en Java</span>
          </div>
          <div class="info-item">
            <span class="info-icon">⏱️</span>
            <span class="info-label">Duración</span>
            <span class="info-value">60 minutos</span>
          </div>
          <div class="info-item">
            <span class="info-icon">📊</span>
            <span class="info-label">Nivel</span>
            <span class="info-value">Avanzado</span>
          </div>
          <div class="info-item">
            <span class="info-icon">🎁</span>
            <span class="info-label">Entregable</span>
            <span class="info-value">Endpoint /api/legacy/consultar funcional</span>
          </div>
        </div>
        <div class="tech-stack-preview">
          <span class="tech-badge">☕ Java 21 LTS</span>
          <span class="tech-badge">🐘 Gradle 8</span>
          <span class="tech-badge">🍃 Spring Boot 4.1.0</span>
          <span class="tech-badge">🧠 Spring AI 1.0</span>
          <span class="tech-badge">📦 Embeddings Locales</span>
          <span class="tech-badge">🔍 VectorStore</span>
        </div>
      </div>

      <!-- Slide 2: Context -->
      <div *ngIf="slide.type === 'context'" class="slide-content">
        <h2>{{ context.title }}</h2>

        <div class="scenario-box">
          <h3>
            <span>{{ context.scenario.icon }}</span>
            Escenario
          </h3>
          <p>{{ context.scenario.text }}</p>
        </div>

        <div class="use-cases-grid">
          <div *ngFor="let uc of context.useCases" class="use-case-card">
            <div class="use-case-icon">{{ uc.icon }}</div>
            <h4>{{ uc.title }}</h4>
            <p>{{ uc.description }}</p>
          </div>
        </div>
      </div>

      <!-- Slide 3: RAG Architecture -->
      <div *ngIf="slide.type === 'rag-architecture'" class="slide-content">
        <h2>{{ ragArchitecture.title }}</h2>

        <div class="explanation-box">
          <p>{{ ragArchitecture.explanation }}</p>
        </div>

        <div class="rag-flow">
          <h4>Flujo RAG Paso a Paso</h4>
          <div class="flow-steps">
            <div *ngFor="let step of ragArchitecture.flow; let last = last" class="rag-step">
              <div class="rag-step-inner">
                <span class="rag-step-icon">{{ step.icon }}</span>
                <span class="rag-step-number">{{ step.step }}</span>
                <span class="rag-step-label">{{ step.label }}</span>
                <small class="rag-step-detail">{{ step.detail }}</small>
              </div>
              <span *ngIf="!last" class="flow-arrow">→</span>
            </div>
          </div>
        </div>

        <div class="components-grid">
          <div *ngFor="let comp of ragArchitecture.components" class="component-card">
            <h4>
              <span class="material-icons">extension</span>
              {{ comp.name }}
            </h4>
            <p class="component-purpose">{{ comp.role }}</p>
            <code class="spring-class">{{ comp.springAiClass }}</code>
          </div>
        </div>
      </div>

      <!-- Slide 4: Spring AI Setup -->
      <div *ngIf="slide.type === 'spring-ai-setup'" class="slide-content">
        <h2>{{ springAiSetup.title }}</h2>

        <div class="code-split">
          <div class="code-block">
            <h4>📦 build.gradle.kts</h4>
            <pre><code>{{ springAiSetup.gradleSnippet }}</code></pre>
          </div>
          <div class="code-block">
            <h4>⚙️ application.yml</h4>
            <pre><code>{{ springAiSetup.applicationYml }}</code></pre>
          </div>
        </div>
      </div>

      <!-- Slide 5: Indexing Service -->
      <div *ngIf="slide.type === 'indexing-service'" class="slide-content">
        <h2>{{ indexingService.title }}</h2>

        <div class="description-box">
          <p>{{ indexingService.description }}</p>
        </div>

        <div class="example-box">
          <h4>LegacyDocIndexingService.java</h4>
          <pre><code>{{ indexingService.javaCode }}</code></pre>
        </div>
      </div>

      <!-- Slide 6: Query Service -->
      <div *ngIf="slide.type === 'query-service'" class="slide-content">
        <h2>{{ queryService.title }}</h2>

        <div class="example-box">
          <h4>LegacyKnowledgeService.java + ConsultaResponse record</h4>
          <pre><code>{{ queryService.javaCode }}</code></pre>
        </div>
      </div>

      <!-- Slide 7: Challenge -->
      <div *ngIf="slide.type === 'challenge'" class="slide-content">
        <h2>
          <span class="material-icons">emoji_events</span>
          {{ challenge.title }}
        </h2>

        <div class="challenge-description">
          <p>{{ challenge.description }}</p>
        </div>

        <div class="requirements-section">
          <h3>Requisitos Técnicos</h3>
          <ul class="requirements-list">
            <li *ngFor="let req of challenge.requirements">
              <span class="material-icons">check_circle</span>
              {{ req }}
            </li>
          </ul>
        </div>

        <div class="prompt-card">
          <h4>
            <span class="material-icons">psychology</span>
            Prompt para Copilot
          </h4>
          <ul class="prompt-list">
            <li *ngFor="let p of challenge.promptCopilot">{{ p }}</li>
          </ul>
        </div>

        <div class="time-estimate">
          <span class="material-icons">schedule</span>
          Tiempo estimado: {{ challenge.timeEstimate }}
        </div>
      </div>

      <!-- Slide 8: Best Practices -->
      <div *ngIf="slide.type === 'best-practices'" class="slide-content">
        <h2>Mejores Prácticas — Spring AI RAG</h2>

        <div class="practices-grid">
          <div *ngFor="let category of bestPractices" class="practice-category">
            <h3>
              <span class="material-icons">star</span>
              {{ category.category }}
            </h3>
            <ul class="practices-list">
              <li *ngFor="let practice of category.practices">
                <span class="material-icons">arrow_right</span>
                {{ practice }}
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Slide 9: Summary -->
      <div *ngIf="slide.type === 'summary'" class="slide-content">
        <h2>Resumen — Spring AI RAG en Java</h2>

        <div class="summary-grid">
          <div class="summary-card">
            <span class="material-icons">inventory</span>
            <h3>Stack Utilizado</h3>
            <ul>
              <li>Java 21 + Spring Boot 4.1.0 + Gradle 8</li>
              <li>Spring AI 1.0 (RAG nativo)</li>
              <li>TransformersEmbeddingModel (local, sin API key)</li>
              <li>SimpleVectorStore → PgVectorStore en prod</li>
              <li>PagePdfDocumentReader + TokenTextSplitter</li>
            </ul>
          </div>

          <div class="summary-card">
            <span class="material-icons">psychology</span>
            <h3>Caso de Uso Clave</h3>
            <ul>
              <li>Indexar manuales COBIS / especificaciones VB6 / docs .NET</li>
              <li>Consulta en lenguaje natural: "¿Qué hace sp_apertura_cuenta?"</li>
              <li>Respuesta fundamentada en documentos reales</li>
              <li>Cita la fuente (sistema + módulo)</li>
              <li>Evita alucinaciones del LLM</li>
            </ul>
          </div>

          <div class="summary-card">
            <span class="material-icons">build</span>
            <h3>Prompting para RAG con Copilot</h3>
            <ul>
              <li>Especificar Spring AI 1.0 — no LangChain, no Python</li>
              <li>Pedir embeddings locales (Transformers) — sin costo</li>
              <li>Incluir metadatos: sistema, módulo, fuente</li>
              <li>Pedir Java records para DTOs de respuesta</li>
              <li>Generar test de integración: indexar → consultar → verificar</li>
            </ul>
          </div>
        </div>

        <div class="completion-badge">
          <span class="material-icons">check_circle</span>
          <span>Clase 10 completada — RAG con Spring AI en Java</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Slide Indicators -->
  <div class="slide-indicators">
    <span
      *ngFor="let slide of slides; let i = index"
      class="indicator"
      [class.active]="currentSlide === i"
      (click)="goToSlide(i)">
    </span>
  </div>

</div>
</file>

