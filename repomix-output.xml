  position: relative;
  color: #4a5568;
  line-height: 1.6;
}

.summary-card li::before {
  content: "▸";
  position: absolute;
  left: 0;
  color: #667eea;
  font-weight: 700;
}

.quote-box {
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  border-left: 4px solid #667eea;
