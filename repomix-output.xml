<file path="src/app/clase7-dev-frontend-legacy/clase7-dev-frontend-legacy.component.html">
<div class="presentation-container" (keydown)="onKeydown($event)" tabindex="0">
  <!-- Back to Study Plan Button -->
  <div class="back-to-menu">
    <a routerLink="/study-plan" class="back-btn">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Volver al Plan de Estudio</span>
    </a>
  </div>

  <!-- Navigation Controls -->
  <div class="controls">
    <button (click)="prevSlide()" [disabled]="currentSlide === 0" class="control-btn">
      ← Anterior
    </button>
    <span class="slide-counter">{{ currentSlide + 1 }} / {{ slides.length }}</span>
    <button (click)="nextSlide()" [disabled]="currentSlide === slides.length - 1" class="control-btn">
      Siguiente →
    </button>
  </div>

  <!-- Slide Container -->
  <div class="slide-wrapper">
    <div class="slide" *ngFor="let slide of slides; let i = index" [class.active]="i === currentSlide">

      <!-- Slide 1: Title -->
      <div *ngIf="slide.type === 'title'" class="slide-title">
        <div class="workshop-badge">🔄 CLASE 7 DEV</div>
        <h1>Modernización Frontend (Legacy JS/jQuery → Angular 19)</h1>
        <h2 class="subtitle">Refactorización asistida: De Scripts imperativos a Componentes Declarativos con Signals</h2>
        <div class="info-grid">
          <div class="info-item">
            <span class="icon">⏱️</span>
            <span class="label">Duración</span>
            <span class="value">90 minutos</span>
          </div>
          <div class="info-item">
            <span class="icon">📊</span>
            <span class="label">Estructura</span>
            <span class="value">30 min teoría + 60 min práctica</span>
          </div>
          <div class="info-item">
            <span class="icon">🎁</span>
            <span class="label">Entregable</span>
            <span class="value">Componente Signals refactorizado</span>
          </div>
          <div class="info-item">
            <span class="icon">💪</span>
            <span class="label">Nivel</span>
            <span class="value">Avanzado</span>
          </div>
        </div>
        <div class="tech-stack-preview">
          <span class="tech-badge">🟨 Legacy JS / jQuery</span>
          <span class="tech-badge">🅰️ Angular 19</span>
          <span class="tech-badge">⚡ Signals</span>
          <span class="tech-badge">🎨 Tailwind CSS v4</span>
        </div>
      </div>

      <!-- Slide 2: Context -->
      <div *ngIf="slide.type === 'context'" class="slide-content">
        <h2>📋 Contexto del Proyecto</h2>

        <div class="scenario-box">
          <div class="scenario-icon">🏢</div>
          <div class="scenario-text">
            <h3>Escenario</h3>
            <p>{{ context.scenario }}</p>
          </div>
        </div>

        <div class="problems-section">
          <h3>🔥 Problemas Críticos</h3>
          <div class="problems-grid">
            <div *ngFor="let problem of context.problems" class="problem-card" [attr.data-color]="problem.color">
              <div class="problem-header">
                <span class="problem-icon">{{ problem.icon }}</span>
                <h4>{{ problem.title }}</h4>
              </div>
              <p>{{ problem.description }}</p>
            </div>
          </div>
        </div>

        <div class="goals-section">
          <h3>🎯 Objetivos de Modernización</h3>
          <ul class="goals-list">
            <li *ngFor="let goal of context.modernGoals">
              <span class="goal-icon">✓</span>
              {{ goal }}
            </li>
          </ul>
        </div>
      </div>

      <!-- Slide 3: Refactoring Strategy -->
      <div *ngIf="slide.type === 'refactoring-strategy'" class="slide-content">
        <h2>🗺️ Estrategia de Refactoring</h2>

        <div class="strategy-timeline">
          <div *ngFor="let step of refactoringStrategy.steps; let idx = index" class="strategy-phase" [attr.data-color]="step.color">
            <div class="phase-header">
              <span class="phase-number">{{ idx + 1 }}</span>
              <span class="phase-icon">{{ step.icon }}</span>
              <h3>{{ step.phase }}</h3>
            </div>
            <ul class="phase-tasks">
              <li *ngFor="let task of step.tasks">{{ task }}</li>
            </ul>
          </div>
        </div>

        <div class="strategy-tip">
          <span class="tip-icon">💡</span>
          <p><strong>Tip Profesional:</strong> Refactorizar incrementalmente. No intentar hacer todo a la vez. Validar performance con Chrome DevTools y Angular DevTools después de cada fase.</p>
        </div>
      </div>

      <!-- Slide 4: Unsubscribe Patterns -->
      <div *ngIf="slide.type === 'unsubscribe-patterns'" class="slide-content">
        <h2>🛑 Patrones de Unsubscribe</h2>

        <div class="pattern-section legacy-pattern">
          <h3>{{ unsubscribePatterns.legacy.title }}</h3>
          <pre class="code-block"><code>{{ unsubscribePatterns.legacy.code }}</code></pre>
