  gap: 0.75rem;
}

.requirements-list li {
  display: flex;
  align-items: start;
  gap: 0.75rem;
  padding: 1rem;
  background: white;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}

.requirements-list .material-icons {
  color: #10b981;
  font-size: 1.5rem;
  margin-top: 0.1rem;
}

/* Challenges Grid */
.challenges-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
