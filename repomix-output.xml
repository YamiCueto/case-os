  <a routerLink="/academy/home" class="flex items-center gap-2">
    <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-sm">
      DEV
    </div>
    <span class="font-bold text-white text-sm">CASE Academy</span>
  </a>
  <button (click)="toggleMobileMenu()" class="p-2 text-slate-400 hover:text-white">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</header>

<!-- Mobile Menu Overlay -->
<div *ngIf="mobileMenuOpen()" class="md:hidden fixed inset-0 z-50 bg-slate-950/95 flex flex-col p-4 overflow-y-auto">
  <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
    <span class="font-bold text-white text-lg">CASE Academy</span>
    <button (click)="closeMobileMenu()" class="p-2 text-slate-400 hover:text-white">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="space-y-4">
    <ng-container *ngFor="let section of sections">
      <div class="space-y-2">
        <div class="pt-2 text-xs font-semibold text-slate-400 uppercase">{{ section.title }}</div>
        <a *ngFor="let item of section.items"
           (click)="closeMobileMenu()" 
           [routerLink]="item.path" 
           class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800">
          {{ item.icon }} {{ item.title }}
          <span *ngIf="item.state === 'COMING_SOON'" class="ml-2 text-[10px] font-bold bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded uppercase">Pronto</span>
        </a>
      </div>
      
      <ng-container *ngIf="section.title === 'Módulos'">
        <div *ngFor="let mod of modules" class="pt-2">
          <div class="text-xs font-semibold text-slate-400 uppercase mb-2">{{ mod.icon }} {{ mod.title }}</div>
          <ng-container *ngIf="mod.state === 'LIVE'">
            <a *ngFor="let lesson of mod.lessons"
               (click)="closeMobileMenu()" 
               [routerLink]="lesson.path" 
               class="block px-3 py-1.5 text-sm text-slate-300 ml-4">
              {{ lesson.icon }}: {{ lesson.title }}
