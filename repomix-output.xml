            <span class="timer-icon">⏱️</span>
            <span>Tiempo estimado: {{ challenge.time }}</span>
          </div>
        </div>
      </div>

      <!-- Slide 7: Best Practices -->
      <div *ngIf="slide.type === 'best-practices'" class="slide-content">
        <h2>✨ Mejores Prácticas</h2>

        <div class="practices-grid">
          <div *ngFor="let category of bestPractices" class="practice-category">
            <div class="category-header">
              <span class="category-icon">{{ category.icon }}</span>
              <h3>{{ category.category }}</h3>
            </div>
            <ul class="practices-list">
              <li *ngFor="let practice of category.practices">{{ practice }}</li>
            </ul>
          </div>
        </div>

        <div class="tip-box">
          <span class="tip-icon">💡</span>
          <p><strong>Recomendación Final:</strong> Usar Angular DevTools Profiler para medir impacto real de optimizaciones. No optimizar prematuramente sin métricas.</p>
        </div>
      </div>

      <!-- Slide 8: Summary -->
      <div *ngIf="slide.type === 'summary'" class="slide-content">
        <h2>🎓 Resumen de la Clase</h2>

        <div class="summary-grid">
          <div class="summary-card achievements-card">
            <h3>🎯 Logros Alcanzados</h3>
            <ul>
              <li *ngFor="let achievement of summary.achievements">{{ achievement }}</li>
            </ul>
          </div>

          <div class="summary-card tools-card">
            <h3>🛠️ Herramientas Clave</h3>
            <div class="tools-list">
              <div *ngFor="let tool of summary.tools" class="tool-item">
                <span class="tool-icon">{{ tool.icon }}</span>
                <div class="tool-info">
                  <strong>{{ tool.name }}</strong>
                  <p>{{ tool.use }}</p>
                </div>
              </div>
            </div>
          </div>

          <div class="summary-card nextsteps-card">
            <h3>🚀 Próximos Pasos</h3>
            <ol class="next-steps">
              <li *ngFor="let step of summary.nextSteps">{{ step }}</li>
            </ol>
          </div>
        </div>

        <div class="completion-badge">
          <span class="badge-icon">✅</span>
          <span class="badge-text">Clase 7 Completada - Modernización Frontend Legacy</span>
        </div>
      </div>

    </div>
  </div>
</div>
