          <span>Problemas Comunes y Soluciones</span>
        </h4>
        <div class="space-y-3">
          <div *ngFor="let item of selectedGuide.troubleshooting"
               class="bg-red-50 border-l-4 border-red-400 p-4 rounded">
            <p class="font-semibold text-red-800 mb-2">❌ {{item.problem}}</p>
            <p class="text-red-700 text-sm">💡 <strong>Solución:</strong> {{item.solution}}</p>
          </div>
        </div>
      </div>

      <!-- Official Docs & Related Classes -->
