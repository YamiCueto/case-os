<div *ngIf="context()?.currentLesson as lesson" class="bg-slate-900 border border-slate-800 rounded-2xl p-6 mb-8">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
    <h1 class="text-2xl font-extrabold text-white">{{ lesson.title }}</h1>
    <div class="flex flex-wrap items-center gap-2">
      <span class="bg-slate-800 text-slate-300 text-xs px-2 py-1 rounded font-medium flex items-center gap-1">
        ⏱️ {{ lesson.duration }}
      </span>
      <span class="bg-indigo-500/20 text-indigo-400 text-xs px-2 py-1 rounded font-bold uppercase">
        {{ lesson.difficulty }}
      </span>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 mb-6">
    <span *ngFor="let tag of lesson.tags" class="text-[10px] uppercase font-bold tracking-wider text-slate-500 bg-slate-950 px-2 py-1 rounded border border-slate-800">
      {{ tag }}
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div *ngIf="lesson.objectives?.length">
      <h3 class="text-sm font-bold text-slate-300 mb-2 uppercase tracking-wide">Objetivos de la clase</h3>
      <ul class="space-y-1">
        <li *ngFor="let obj of lesson.objectives" class="text-sm text-slate-400 flex items-start gap-2">
          <span class="text-indigo-400 mt-0.5">•</span>
          <span>{{ obj }}</span>
        </li>
      </ul>
    </div>
    <div *ngIf="lesson.resources?.length">
      <h3 class="text-sm font-bold text-slate-300 mb-2 uppercase tracking-wide">Recursos recomendados</h3>
      <ul class="space-y-1">
        <li *ngFor="let res of lesson.resources">
          <a [href]="res.url" target="_blank" class="text-sm text-indigo-400 hover:text-indigo-300 flex items-center gap-1">
            📄 {{ res.title }}
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>
</file>

