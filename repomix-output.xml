}

.next-step-item p {
  margin: 0;
  color: #6b7280;
}

/* Prompt Card */
.prompt-card {
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  border: 2px solid #667eea;
  border-radius: 12px;
  padding: 2rem;
  margin: 2rem 0;
}

.prompt-card h4 {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1.25rem;
  font-weight: 700;
  color: #667eea;
  margin: 0 0 1.5rem 0;
}

.prompt-card .material-icons {
  font-size: 1.8rem;
}

.prompt-section {
  background: white;
  padding: 1rem 1.5rem;
  border-radius: 8px;
  margin-bottom: 1rem;
}

.prompt-section:last-child {
  margin-bottom: 0;
}

.prompt-section strong {
  display: block;
  color: #667eea;
  font-weight: 700;
  margin-bottom: 0.75rem;
  font-size: 0.95rem;
}

.prompt-section p {
  margin: 0;
  color: #374151;
  line-height: 1.6;
}

.prompt-section ul,
.prompt-section ol {
  margin: 0;
  padding-left: 1.5rem;
  color: #374151;
}

.prompt-section li {
  margin-bottom: 0.5rem;
  line-height: 1.6;
}

.prompt-section li:last-child {
  margin-bottom: 0;
}

/* Hints Section */
.hints-section {
  background: #f0fdf4;
  border-left: 4px solid #10b981;
  border-radius: 8px;
  padding: 1.5rem;
  margin: 2rem 0;
}

.hints-section h4 {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #047857;
  margin: 0 0 1rem 0;
}

.hints-section .material-icons {
  color: #10b981;
  font-size: 1.5rem;
}

.hints-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.hints-list li {
  padding: 0.75rem 0;
  padding-left: 1.5rem;
  position: relative;
  color: #065f46;
  line-height: 1.6;
}

.hints-list li::before {
  content: "💡";
  position: absolute;
  left: 0;
}

/* Time Estimate */
.time-estimate {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  justify-content: center;
  background: #fef3c7;
  padding: 1rem;
  border-radius: 8px;
  margin-top: 2rem;
  font-weight: 600;
  color: #92400e;
}

.time-estimate .material-icons {
  color: #f59e0b;
  font-size: 1.5rem;
}

/* Challenge Description */
.challenge-description {
  background: white;
  padding: 1.5rem;
  border-radius: 8px;
  margin-bottom: 2rem;
  border-left: 4px solid #667eea;
}

.challenge-description p {
  margin: 0;
  color: #374151;
  font-size: 1.05rem;
  line-height: 1.6;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .dto-section {
    grid-template-columns: 1fr;
  }

  .mapping-arrow .material-icons {
    transform: rotate(90deg);
  }

  .strategies-grid,
  .components-grid,
  .challenges-grid {
    grid-template-columns: 1fr;
  }

  .flow-steps {
    flex-direction: column;
  }

  .flow-arrow {
    transform: rotate(90deg);
  }
}
