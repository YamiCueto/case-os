  min-width: 120px;
}

.step-number {
  background: #667eea;
  color: white;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.step-label {
  font-size: 0.85rem;
  text-align: center;
  font-weight: 600;
}

.flow-arrow {
  font-size: 2rem;
  color: #667eea;
  font-weight: bold;
}

/* Scenario Box */
.scenario-box {
