  padding: 1.5rem;
  border-radius: 8px;
  margin-bottom: 2rem;
}

.challenge-description p {
  margin: 0;
  color: #374151;
  font-size: 1.05rem;
  line-height: 1.7;
}

.requirements-section {
  margin: 2rem 0;
}

.requirements-section h3 {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 1rem;
}

.requirements-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0.75rem;
}

.requirements-list li {
  display: flex;
  align-items: center;
