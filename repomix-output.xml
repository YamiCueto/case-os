              <li *ngFor="let problem of changeDetectionStrategy.default.problems">{{ problem }}</li>
            </ul>
          </div>
        </div>

        <div class="cd-section onpush-section">
          <h3>{{ changeDetectionStrategy.onPush.title }}</h3>
          <p class="cd-description">{{ changeDetectionStrategy.onPush.description }}</p>
          <pre class="code-block"><code>{{ changeDetectionStrategy.onPush.code }}</code></pre>

          <div class="cd-details">
            <div class="benefits-column">
              <h4>✅ Beneficios:</h4>
              <ul>
                <li *ngFor="let benefit of changeDetectionStrategy.onPush.benefits">{{ benefit }}</li>
              </ul>
            </div>
            <div class="requirements-column">
              <h4>📋 Requisitos:</h4>
              <ul>
                <li *ngFor="let req of changeDetectionStrategy.onPush.requirements">{{ req }}</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="immutability-section">
          <h3>{{ changeDetectionStrategy.immutability.title }}</h3>
          <pre class="code-block"><code>{{ changeDetectionStrategy.immutability.code }}</code></pre>
        </div>
      </div>

      <!-- Slide 6: Challenge -->
      <div *ngIf="slide.type === 'challenge'" class="slide-content">
        <h2>🎯 Ejercicio Práctico</h2>

        <div class="challenge-container">
          <div class="challenge-header">
            <span class="challenge-icon">🔧</span>
            <h3>{{ challenge.title }}</h3>
